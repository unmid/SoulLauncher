{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soul Launcher",
  "version": "1.0.0",
  "identifier": "com.soul.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Soul Launcher",
        "width": 1240,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-context-menu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' https: ipc: http://ipc.localhost; font-src 'self' data:; frame-src https://unmid.github.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Fast, lightweight Minecraft launcher",
    "publisher": "Soul Launcher Contributors",
    "copyright": "Copyright © 2026 Soul Launcher Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/unmid/SoulLauncher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbWVudDogbWluaXNpZ24gcHVibGljIGtleTogIENGQjA3RDhGRURGNTJBNDAKUldSQUt2WHRqMzJ3ejlPS1JKaVJsN3lrM1dJSENaT3hpTjBPcHlKTUNMRGJycmM4bjgzamRLTGIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
